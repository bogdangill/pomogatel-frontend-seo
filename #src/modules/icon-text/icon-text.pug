mixin icon-text(data)
    //- Принимает:
    //- mods    {string} - список модификаторов(если нужны)
    //- модификаторы модуля(разновидности в ui-kit'е): 
    //- kind(специальности), hint(подсказки), check(проверки)

    //- Вызов:
        +icon-text({
            'mods': '...someMods',
            'iconId': 'ид иконки из спрайта',
            'iconSize': 'sm|md|lg'
            'text': 'sometext'
        })
    -
        // список модификаторов
        let allMods = '';
        let iconMod = '';

        if(typeof(data.mods) !== 'undefined' && data.mods) {
            let modsList = data.mods.split(',');

            for (let i = 0; i < modsList.length; i++) {
                allMods = allMods + ' icon-text--' + modsList[i].trim();
            }
        }

        if (data.iconSize === 'sm') iconMod = 'icon-text__icon--sm';
        if (data.iconSize === 'md') iconMod = 'icon-text__icon--md';
        if (data.iconSize === 'lg') iconMod = 'icon-text__icon--lg';
        if (data.iconSize === 'xl') iconMod = 'icon-text__icon--xl';

    .icon-text(class=allMods)
        .icon-text__icon(class=iconMod)
            if (country === 'vn' || country === 'tr')
                img(src="./img/icons/sprite.svg#"+data.iconId, alt=data.text)
            else
                svg
                    use(xlink:href="./img/icons/sprite.svg#"+data.iconId)
        if (typeof(data.href) !== 'undefined' && data.href)
            a.icon-text__link(href=data.href)!=data.text
            .icon-text__circle
        else
            span.icon-text__text!=data.text
                