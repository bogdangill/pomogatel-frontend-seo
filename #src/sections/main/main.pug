include ../../modules/btn/btn.pug
include ../../modules/title/title.pug
mixin main()
    -
        let modifier = 'main--default ';
        let btnMods = 'primary';
        let titleMod = '';

        if (country === 'vn') modifier = 'main--vn ';
        if (country === 'tr') modifier = 'main--tr ';
        if (country === 'vn' || country === 'tr') btnMods = 'secondary, blink';
        if (country === 'vn' || country === 'tr') titleMod = 'title--primary-dark';

    section.main(class=modifier + bodyClass + '__main')
        +title({
            'text': main.title,
            'parent': 'main',
            'mods': `lg ${titleMod}`
        })
        p.main__text!=main.text
        +btn({
            'text': main.btnText,
            'mods': 'lg, '+btnMods
        })(data-action="registration" data-ga-label="main_button" data-ga-action="main_page" data-registration-state="unregistrated" data-ripple="btn")