extends ../../layouts/layout-default.pug
include connectors/_index.connector.pug

block meta
    title Домашний персонал в Москве на Помогатель.ру: няни, домработницы, сиделки, репетиторы

block body
    - var bodyClass = 'index';

    body(class=bodyClass)
        .wrapper
            block header
                +header()
            block content
                main
                    +promo()
                    +kinds()
                    +steps()
                    +best-workers()
                    +reviews()
                    +faq()
                    +verification()
                    +promo-app()
            block footer
                +footer()
block page-bottom
    script(src='./js/index.min.js')