mixin steps()
    -
        let modifier = '';
        let btnMods = 'primary';
        let iconTextMods = '';

        if (country === 'ru') modifier = 'default';
        if (country === 'vn' || country === 'tr') modifier = 'bright';
        if (country === 'vn' || country === 'tr') btnMods = 'secondary, blink';
        if (country === 'vn' || country === 'tr') {
            iconTextMods = ' icon-text--no-halo'; //выключаю статичный белый ореол-нимб вокруг иконки
        }

    section.steps(class=bodyClass+'__steps'+' steps--'+modifier)
        h2.title.steps__title.title--md!= steps.title

        .steps__row
            each role in steps.roles
                section.steps__col
                    h3.title.steps__subtitle.title--xs!= role.title
                    ul.grid-list.steps__list.grid-list--vertical
                        each item in role.list
                            li.grid-list__item
                                +icon-text({
                                    'mods': 'hint'+iconTextMods,
                                    'iconId': item.icon,
                                    'iconSize': 'md',
                                    'text': item.text
                                })
                    +btn({
                        'text': role.btnText,
                        'mods': 'ripple, md, '+btnMods
                    })(class="steps__btn")
