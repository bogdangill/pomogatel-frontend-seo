mixin verification()
    section.verification(class=bodyClass+'__verification')
        +title({
            'level': 2,
            'text': verification.title,
            'mods': 'md',
            'parent': 'verification'
        })
        p.verification__text!= verification.text
        ul.grid-list.verification__list
            each item in verification.list
                li.grid-list__item
                    +icon-text({
                        'mods': 'check',
                        'iconId': item.iconId,
                        'iconSize': 'xl',
                        'text': item.text
                    })