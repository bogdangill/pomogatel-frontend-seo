include ../../modules/btn/btn.pug
include ../../modules/iconText/iconText.pug
include ../../modules/title/title.pug
mixin steps()
    -
        let modifier = '';
        let btnMods = 'primary';
        let iconTextMods = '';

        if (country === 'ru') modifier = 'default';
        if (country === 'vn' || country === 'tr') modifier = 'bright';
        if (country === 'vn' || country === 'tr') btnMods = 'secondary, blink';
        if (country === 'vn' || country === 'tr') {
            iconTextMods = ' icon-text--no-halo'; //выключаю статичный белый ореол-нимб вокруг иконки
        }

    section.steps(class=bodyClass+'__steps'+' steps--'+modifier)
        +title({
            'level': 2,
            'text': steps.title,
            'parent': 'steps',
            'mods': 'md'
        })

        .steps__row
            each role in steps.roles
                section.steps__col
                    +title({
                        'level': 3,
                        'text': role.title,
                        'mods': 'xs'
                    })(class="steps__subtitle")
                    ul.steps__list
                        each item in role.list
                            li
                                +iconText({
                                    'mods': 'hint'+iconTextMods,
                                    'iconId': item.icon,
                                    'iconSize': 'md',
                                    'text': item.text
                                })
                    +btn({
                        'text': role.btnText,
                        'mods': 'md, '+btnMods
                    })(class="steps__btn" data-ripple="btn")
