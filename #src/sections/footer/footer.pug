mixin footer()
    -
        let btnMods = 'primary';
        if (country === 'vn' || country === 'tr') btnMods = 'secondary, blink';

    footer.footer.wrapper__footer
        .footer__container
            .footer__top
                .footer__col
                    +logo({
                        'mods': 'footer',
                        'text': footer.logoText,
                    })(class="footer__logo")
                    if (typeof(footer.phoneNumber) !== 'undefined' && footer.phoneNumber)
                        +btn({
                            'text': footer.phoneNumber,
                            'mods': 'link'
                        })(href=footer.phoneHref class="footer__phone footer__phone--desktop")
                .footer__menu
                    each item in footer.menu
                        ul.footer__col
                            each link in item
                                li.footer__link
                                    +btn({
                                        'text': link.text,
                                        'mods': 'link'
                                    })(href=link.href class=link.class)
                    if (typeof(footer.support) !== 'undefined' && footer.support)
                        ul.footer__col
                            li.footer__text!= footer.support.text
                            li.footer__link
                                +btn({
                                    'text': footer.support.btnText,
                                    'mods': 'ripple, sm, '+btnMods
                                })
            if (typeof(footer.disclaimer) !== 'undefined' && footer.disclaimer)                
                small.footer__disclaimer!= footer.disclaimer
            hr.footer__separator
            .footer__bottom
                +social({
                    'parent': 'footer',
                    'text': footer.social.text,
                    'links': footer.social.buttons
                })
                +download-app({
                    'parent': 'footer',
                    'buttons': footer.appLinks
                })
                

