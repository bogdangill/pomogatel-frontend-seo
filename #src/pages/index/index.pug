extends ../../layouts/layout-default.pug
include ../../sections/best-workers/best-workers.pug
include ../../sections/faq/faq.pug
include ../../sections/footer/footer.pug
include ../../sections/header/header.pug
include ../../sections/kinds/kinds.pug
include ../../sections/main/main.pug
include ../../sections/promo-app/promo-app.pug
include ../../sections/reviews/reviews.pug
include ../../sections/steps/steps.pug
include ../../sections/verification/verification.pug

block meta
    title Домашний персонал в Москве на Помогатель.ру: няни, домработницы, сиделки, репетиторы

block body
    - var bodyClass = 'index';

    body(class=bodyClass)
        .wrapper
            block header
                +header()
            block content
                main
                    +main()
                    +kinds()
                    +steps()
                    +best-workers()
                    +reviews()
                    +faq()
                    +verification()
                    +promo-app()
            block footer
                +footer()
block page-bottom
    script(src='./js/index.min.js')