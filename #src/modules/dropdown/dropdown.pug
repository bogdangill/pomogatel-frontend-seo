mixin dropdown(data)
    //- Принимает:
    //-   mods    {string} - список модификаторов(если нужны)

    //- Вызов:
        +dropdown({
            'mods': '...someMods',
            'items': {
                'item1': {
                    'href': '...someHref',
                    'text': 'sometext'
                },
                'item2': {
                    'href': '...someHref',
                    'text': 'sometext'
                },
                'item3': {
                    'href': '...someHref',
                    'text': 'sometext'
                }
            }
            ...
        })
    -
        // список модификаторов
        let allMods = '';

        if(typeof(data.mods) !== 'undefined' && data.mods) {
            let modsList = data.mods.split(',');

            for (let i = 0; i < modsList.length; i++) {
                allMods = allMods + 'dropdown--' + modsList[i].trim();
            }
        }

        //регулярка для поиска dropdown items
        let urgentKeyName = /(item)\d+/;

        let defaultValue = data.items['item1']['text'].split(' и ')[0];

    .dropdown(class=allMods data-dropdownid=data.id)
        button.dropdown__value(aria-haspopup="true" aria-expanded="false" id="ddRegions")!=defaultValue
        svg.dropdown__icon
            use(xlink:href="img/icons/sprite.svg#arrow-bottom")
        ul.dropdown-body.dropdown-body--hidden(aria-labelledby="ddRegions")
            each key in Object.keys(data.items)
                if (urgentKeyName.test(key))
                    li.dropdown-body__item
                        if (typeof(data.items[key].href) !== 'undefined' && data.items[key].href)
                            -
                                let href = data.items[key].href;
                            a(href=href)!=data.items[key].text