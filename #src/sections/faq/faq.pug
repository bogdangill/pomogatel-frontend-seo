include ../../modules/accordion/accordion.pug
include ../../modules/btn/btn.pug
include ../../modules/title/title.pug
mixin faq()
    section.faq(class=bodyClass+'__faq')
        +title({
            'level': 2,
            'text': faq.title,
            'mods': 'md',
            'parent': 'faq'
        })

        .faq__row
            each role in faq.roles
                .faq__col
                    +title({
                        'level': 3,
                        'text': role.title,
                        'mods': 'xs'
                    })(class="faq__subtitle")
                    ul.faq__list
                        each item in role.list
                            li
                                +accordion({
                                    'titleLevel': 4,
                                    'title': item.title,
                                    'text': item.text
                                })
                    if (typeof(role.linkText) !== 'undefined' && role.linkText)
                        +btn({
                            'mods': 'link, link--primary',
                            'text': role.linkText
                        })(class="faq__link" href=role.linkHref)