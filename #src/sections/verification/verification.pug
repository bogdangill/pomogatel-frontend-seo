include ../../modules/iconText/iconText.pug
include ../../modules/title/title.pug
mixin verification()
    .verification(class=bodyClass+'__verification')
        section.verification__inner
            +title({
                'level': 2,
                'text': verification.title,
                'mods': 'md',
                'parent': 'verification'
            })
            p.verification__text!= verification.text
            ul.verification__list
                each item in verification.list
                    li
                        +iconText({
                            'mods': 'check',
                            'iconId': item.iconId,
                            'iconSize': 'xl',
                            'text': item.text
                        })