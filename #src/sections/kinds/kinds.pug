mixin kinds()
    -
        let listMod = '';
        let iconSize = 'sm';

        if (country === 'vn' || country === 'tr') listMod = 'kinds__list--wide';
        if (country === 'vn' || country === 'tr') iconSize = 'lg';

    .kinds(class=bodyClass+'__kinds')
        each kind in kinds
            .kinds__col
                p.kinds__title!= kind.title
                ul.kinds__list(class=listMod)
                    each item in kind.list
                        li
                            +icon-text({
                                'mods': 'kind, no-halo',
                                'iconId': item.icon,
                                'iconSize': iconSize,
                                'text': item.text,
                                'href': '../search/search.html'
                            })
