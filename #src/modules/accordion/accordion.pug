mixin accordion(data)
    //- Принимает:
    //-   mods    {string} - список модификаторов через запятую(если нужны)
    //-   title   {string} - заголовок аккордеона
    //-   text    {string} - текст аккордеона
    //-   titleLevel {number} - уровень заголовка для аккордеона(от 2 до 6)

    //- Вызов:
        +accordion({
            'mods': '...someMods',
            'titleLevel': 2,
            'title': 'заголовок аккордеона',
            'text': 'текст'
            ...
        })
    -
        // список модификаторов
        let allMods = '';

        if(typeof(data.mods) !== 'undefined' && data.mods) {
            let modsList = data.mods.split(',');

            for (let i = 0; i < modsList.length; i++) {
                allMods = allMods + 'accordion--' + modsList[i].trim();
            }
        }

        if (data.titleLevel === 2) hx = 'h2';
        if (data.titleLevel === 3) hx = 'h3';
        if (data.titleLevel === 4) hx = 'h4';
        if (data.titleLevel === 5) hx = 'h5';
        if (data.titleLevel === 6) hx = 'h6';

    article.accordion(class=allMods)
        #{hx}.accordion__header
            button.accordion__trigger(aria-expanded="false" aria-controls=data.id)!=data.title
            svg.accordion__icon
                use(xlink:href="./img/icons/sprite.svg#chevron-bottom")
        .accordion__body(id=data.id)
            if (typeof(data.text) !== 'undefined' && data.text)
                p.accordion__text!=data.text
            else
                block