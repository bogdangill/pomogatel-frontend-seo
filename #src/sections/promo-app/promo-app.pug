mixin promo-app()
    .promo-app(class=bodyClass+'__promo-app')
        section.promo-app__col
            +title({
                'level': 2,
                'text': promoApp.title,
                'mods': 'md',
                'parent': 'promo-app'
            })
            p.promo-app__text!= promoApp.text
            +downloadApp({
                'parent': 'promo-app',
                'buttons': promoApp.appLinks
            })
        .promo-app__col.promo-app__col--img
            picture
                source(srcset=promoApp.img+'.webp 1x, '+promoApp.img+'@2x.webp 2x' type="image/webp")
                img(src=promoApp.img+'.png' srcset=promoApp.img+'@2x.png 2x' alt=promoApp.imgAlt)
            picture
                source(srcset=promoApp.imgMobile+'.webp 1x, '+promoApp.imgMobile+'@2x.webp 2x' type="image/webp")
                img(src=promoApp.img+'.png' srcset=promoApp.img+'@2x.png 2x' alt=promoApp.imgAlt)
