mixin reviews()
    -
        let btnTheme = 'outline';

        if (country === 'vn' || country === 'tr') btnTheme = 'secondary';

    .reviews(class=bodyClass+'__reviews')
        section.reviews__wrapper
            h2.title.reviews__title.title--md!= reviews.title
            .reviews__slides(data-slider="reviews")
                ul.grid-list.reviews__list.swiper-wrapper
                    each item in reviews.list
                        li.grid-list__item.swiper-slide
                            +card({
                                'mods': 'review',
                                'name': item.name,
                                'text': item.text,
                                'time': item.date,
                                'datetime': item.datetime
                            })
                .reviews__pagination.swiper-pagination
            
            if (typeof(reviews.btnText) !== 'undefined' && reviews.btnText)
                +btn({
                    'mods': 'md, ripple'+', '+btnTheme,
                    'text': reviews.btnText
                })
